<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <h1 class="govuk-heading-l"><%= @component_title %></h1>
    <p class="govuk-body">Preview of the Ruby renderer for this component. Choose a version below to compare the Ruby HTML with the official fixture from GOV.UK Frontend <%= @layout[:frontend_version] %>.</p>
    <p class="govuk-body"><a class="govuk-link" href="<%= @design_system_url %>"><%= @component_title %> on the GOV.UK Design System</a></p>
    <h2 class="govuk-heading-m">Current version: <%= @fixture_name %></h2>
    <%= govuk("notification-banner", @parity) %>
    <% if @description.present? %>
      <%= govuk("inset-text", @description_inset) %>
    <% end %>
    <div class="app-component-preview">
      <h3 class="govuk-heading-s">Component preview</h3>
      <div class="app-component-preview__frame">
        <%= @rendered %>
      </div>
    </div>
    <h2 class="govuk-heading-m">Versions (Fixtures)</h2>
    <nav aria-label="Versions">
      <ul class="govuk-list">
        <% @fixtures.each do |fixture| %>
          <li>
            <% if fixture[:current] %>
              <strong aria-current="true"><%= fixture[:name] %></strong>
              <%= govuk("tag", @current_tag) %>
            <% else %>
              <a class="govuk-link" href="/components/<%= @component_name %>?fixture=<%= ERB::Util.url_encode(fixture[:name]) %>"><%= fixture[:name] %></a>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>
</div>
