<!DOCTYPE html>
<html lang="<%= @layout[:html_lang] %>" class="govuk-template">
  <head>
    <meta charset="utf-8">
    <title><%= @layout[:page_title] %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#1d70b8">
    <link rel="stylesheet" href="<%= @layout[:stylesheet_href] %>">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" sizes="48x48" href="/assets/images/favicon.ico">
    <link rel="icon" sizes="any" href="/assets/images/favicon.svg" type="image/svg+xml">
    <link rel="mask-icon" href="/assets/images/govuk-icon-mask.svg" color="#1d70b8">
    <link rel="apple-touch-icon" href="/assets/images/govuk-icon-180.png">
    <link rel="manifest" href="/assets/manifest.json">
  </head>
  <body class="govuk-template__body">
    <script><%= raw @layout[:js_enabled_snippet] %></script>
    <% if @layout[:exit_this_page] %>
      <%= govuk("exit-this-page", @layout[:exit_this_page]) %>
    <% end %>
    <%= govuk("skip-link", @layout[:skip_link]) %>
    <% if @layout[:cookie_banner] %>
      <%= form_with url: "/cookie-choices", method: :post, html: { novalidate: true } do %>
        <input type="hidden" name="returnPath" value="<%= @layout[:return_path] %>">
        <%= govuk("cookie-banner", @layout[:cookie_banner]) %>
      <% end %>
    <% end %>
    <header class="govuk-template__header">
      <%= govuk("header", @layout[:header]) %>
      <%= govuk("service-navigation", @layout[:service_navigation]) %>
    </header>
    <div class="govuk-width-container">
      <%= govuk("phase-banner", @layout[:phase_banner]) %>
      <% if @layout[:back_link] %>
        <%= govuk("back-link", @layout[:back_link]) %>
      <% elsif @layout[:breadcrumbs] %>
        <%= govuk("breadcrumbs", @layout[:breadcrumbs]) %>
      <% end %>
      <main class="govuk-main-wrapper<%= " #{@layout[:main_classes]}" if @layout[:main_classes].present? %>" id="main-content">
        <%= govuk("notification-banner", @layout[:demo_banner]) %>
        <%= yield %>
      </main>
    </div>
    <footer class="govuk-template__footer">
      <% if @layout[:show_feedback] %>
        <%= govuk("feedback", @layout[:feedback]) %>
      <% end %>
      <%= govuk("footer", @layout[:footer]) %>
    </footer>
    <script type="module" src="<%= @layout[:app_module_href] %>"></script>
  </body>
</html>
